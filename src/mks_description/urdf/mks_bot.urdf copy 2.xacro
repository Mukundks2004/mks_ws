<?xml version="1.0"?>
<robot name="one_wheel">

  <!-- ===================== -->
  <!-- Wheel -->
  <!-- ===================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
    <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.0025" ixy="0" ixz="0"
        iyy="0.0025" iyz="0"
        izz="0.0025"/>
    </inertial>
  </link>
</robot>
