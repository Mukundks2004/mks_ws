<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="eve">

    <link name="world" />


    <link name="chassis">
        <visual>
            <origin xyz="0 0 0.0" rpy="${pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://mks_description/meshes/chassis.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://mks_description/meshes/chassis.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.1"/>
        </inertial>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="world"/>
        <child link="chassis"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="front_left_leg">
        <visual>
            <origin xyz="-0.247 0.058093 -0.025691" rpy="${pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://mks_description/meshes/front_left_leg.stl" scale="0.001 0.001 0.001"/>
