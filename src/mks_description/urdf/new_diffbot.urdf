<?xml version="1.0"?>
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="blue">
    <color rgba="0 0 1 1" />
  </material>

  <material name="black">
    <color rgba="0 0 0 1" />
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1" />
  </material>

  <link name="world_link"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.8 0.2"/>
      </geometry>
      <material name="blue" />
    </visual>

    <collision>
      <geometry>
        <box size="1.0 0.8 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.068" ixy="0.0" ixz="0.0" iyy="1.968" iyz="0.0" izz="1.5"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 5" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.5"/>
      </geometry>
      <material name="black" />
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.5" radius="0.5"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.25" ixy="0.0" ixz="0.0" iyy="0.20833" iyz="0.0" izz="0.20833"/>
    </inertial>
  </link>

    <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.5"/>
      </geometry>
      <material name="black" />
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.5" radius="0.5"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.25" ixy="0.0" ixz="0.0" iyy="0.20833" iyz="0.0" izz="0.20833"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.65 0" rpy="1.57080 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.65 0" rpy="1.57080 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.475 0 0.125" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>30.0</update_rate>

    <camera name="camera_main">
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
    </camera>

    <topic>/model/diffbot/camera/image_raw</topic>
  </sensor>
</gazebo>

</robot>
