<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <physics name="default_physics" type="ignition">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <include>
      <uri>model://ground_plane</uri>
    </include>

  </world>
</sdf>
