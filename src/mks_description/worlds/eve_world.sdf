<sdf version="1.8">
  <model name="eve">
    <!-- include your URDF -->
    <include>
      <uri>model://eve</uri> <!-- make sure 'eve' is installed as a model -->
    </include>

    <!-- plugin to spin front-left wheel -->
    <plugin name="front_left_wheel_velocity"
            filename="libignition-gazebo-joint-velocity.so">
      <joint_name>front_left_wheel_to_leg</joint_name>
      <velocity>1.0</velocity>
    </plugin>

  </model>
</sdf>
